# ─── ECO-3D Environment Variables ───────────────────────────────────────────
# Copy to .env and fill in values

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default — no setup required, great for development)
DATABASE_URL=sqlite+aiosqlite:///./eco3d.db

# PostgreSQL (production) — uncomment and fill in when ready
# DATABASE_URL=postgresql+asyncpg://eco3d:eco3d@localhost:5432/eco3d

# ── Security ─────────────────────────────────────────────────────────────────
# JWT signing secret. REQUIRED in production (ENVIRONMENT=production) — the
# backend refuses to start without it. In development an ephemeral key is used.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# JWT lifetime in minutes (default 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Comma-separated CORS allowlist for production, e.g. https://app.example.com
# Leave as * for local development.
CORS_ORIGINS=*

# ── External APIs (optional — app runs without these) ────────────────────────
OPENWEATHER_API_KEY=your_openweather_key_here
MAPBOX_TOKEN=your_mapbox_token_here

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
